# Lokale .env für `npm run sync` (Datensync) und `npm test` (Repo-Root).
# Kopieren nach `.env`, echte Werte eintragen, NIE committen (steht in .gitignore).
# Siehe scripts/lib/env.js für die Auflösung, AGENTS.md für den Gesamtkontext.

# --- Notion (Plan 1, Athlet 1 — Notion-Ära) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- intervals.icu (Athlet 1) ---
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# --- intervals.icu (Athlet 2, Vergleichsathlet) ---
INTERVALS_API_KEY_2=
INTERVALS_ATHLETE_ID_2=

# --- intervals.icu (Athlet 3) ---
INTERVALS_API_KEY_3=
INTERVALS_ATHLETE_ID_3=

# --- Wetter (Open-Meteo), Standort ausschließlich über diese Secrets — ---
# --- NIEMALS Koordinaten im Code/JSON/Kommentaren (s. AGENTS.md "Datenschutz") ---
WEATHER_LAT=
WEATHER_LON=
WEATHER_LAT_2=
WEATHER_LON_2=
WEATHER_LAT_3=
WEATHER_LON_3=

# --- Supabase, dev-Projekt (scripts/migrate-plan-to-supabase.js, ---
# --- scripts/lib/plan-cards-fetch.js, scripts/lib/ftp-history.js, ---
# --- tests/supabase-rls.test.js) — ohne diese Werte degradieren die ---
# --- betroffenen Sync-Schritte geräuschlos, kein Fehler ---
# --- Dieselben zwei Werte liest auch docker-compose.dev.yml (Fahrplan 3, ---
# --- DKR1) — ein .env für beides, keine zweite Datei dafür anlegen. ---
# --- Werte OHNE Anführungszeichen eintragen — Docker Compose entfernt sie ---
# --- bei der ${VAR}-Ersetzung nicht, s. docs/docker-lokal-einrichten.md ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ATHLETE1_EMAIL=
SUPABASE_ATHLETE1_PASSWORD=
SUPABASE_ATHLETE2_EMAIL=
SUPABASE_ATHLETE2_PASSWORD=

# --- Supabase, dev-Projekt: Trainer-Account für tests/supabase-rls.test.js ---
# --- (Account "Trainer-ST", coacht dort den SUPABASE_ATHLETE1_EMAIL-Account) ---
SUPABASE_TRAINER_EMAIL=
SUPABASE_TRAINER_PASSWORD=

# --- Supabase, prod-Gegenstücke — NUR für gezielte, manuell mit --env=prod ---
# --- gestartete Einmal-Skripte (z. B. scripts/add-rest-day-cards.js), NIE von ---
# --- npm test/npm run sync gelesen ---
SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=
SUPABASE_ATHLETE1_EMAIL_PROD=
SUPABASE_ATHLETE1_PASSWORD_PROD=

# --- Nur für den Sync-Container (Fahrplan 3, DKR2), optional --- ---
# --- Stunden zwischen zwei automatischen Sync-Läufen im Dauerbetrieb ---
# --- (docker-compose.dev.yml, Dienst "sync"). Ohne diesen Wert: 6h. ---
SYNC_INTERVAL_HOURS=

# --- Nur für den Self-Host-Stack lokal (Fahrplan 3, DKR3) --- ---
# --- docker-compose.selfhost.yml (Postgres/GoTrue/PostgREST). Einmalig ---
# --- zufällig erzeugen (s. docs/docker-lokal-einrichten.md Abschnitt 3), ---
# --- gilt NUR für den eigenen Rechner — hat nichts mit dashboard-dev/-prod ---
# --- zu tun und wird niemals auf einen Server übertragen. ---
POSTGRES_PASSWORD=
JWT_SECRET=
# --- Eigene Passwoerter fuer die DB-Rollen von PostgREST (authenticator) ---
# --- und GoTrue (supabase_auth_admin) - bewusst getrennt vom Superuser- ---
# --- POSTGRES_PASSWORD. Alle drei landen in Verbindungs-URIs, deshalb ---
# --- URL-sicher erzeugen (kein +, / oder = im Wert), z.B.: ---
# --- openssl rand -hex 24 ---
AUTHENTICATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=
