{
  "name": "training-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Radsport-Trainingsdashboard — React (app/) selbst-gehostet als Container-Verbund auf apps01, Datensync via apps01-Sidecar-Container",
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-module-mocks \"tests/**/*.test.js\" \"admin-api/*.test.js\"",
    "sync": "node scripts/generate-data.js",
    "demo:generate": "node scripts/demo/generate.js",
    "demo:init": "node scripts/demo/init.js",
    "demo:up": "docker compose --env-file .env.demo -f docker-compose.demo.yml up -d --build",
    "demo:down": "docker compose --env-file .env.demo -f docker-compose.demo.yml down",
    "demo:seed": "node --env-file-if-exists=.env.demo scripts/demo/seed.js",
    "demo:reset": "node --env-file-if-exists=.env.demo scripts/demo/reset.js",
    "lint": "npx --yes eslint@9 scripts tests",
    "format": "npx --yes prettier@3 --write \"scripts/**/*.js\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "fallow": "^3.34.1"
  }
}
